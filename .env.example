# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se commitea (ver .gitignore) — pide las claves al equipo
# o sácalas del dashboard de Supabase / Cloudflare / Upstash / Resend.

# --- Supabase (proyecto en región UE / Frankfurt) ---
# URL y anon key: público, seguro exponer en el cliente (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SOLO servidor. Nunca prefijar con NEXT_PUBLIC_,
# nunca exponer al cliente, nunca commitear.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (anti-bot en el registro) ---
# Site key: público, se usa en el widget del cliente.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: solo servidor, se usa para validar el token en la Server Action.
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting — instancia en región UE) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (correos transaccionales y de comunicación — docs/email-strategy.md) ---
RESEND_API_KEY=
# Remitente verificado en Resend: "BeWay <comunicaciones@bbeway.com>"
# (mismo remitente que supabase/config.toml > [auth.email.smtp].admin_email
# — usar cualquier otro dominio no verificado en Resend hace que Resend
# rechace el envío con 550 "domain is not verified"). Sin un dominio
# verificado en Resend, deja esto vacío — el código usa por defecto el
# dominio de pruebas de Resend (onboarding@resend.dev), que SOLO entrega
# correos a la propia cuenta de Resend, no a usuarios reales.
RESEND_FROM_EMAIL=

# --- URL base del sitio (para enlaces absolutos en correos y en la app) ---
# En producción: https://bbeway.com (dominio verificado). El script
# scripts/build-auth-email-templates.mjs fija este valor a bbeway.com por
# su cuenta al generar supabase/templates/*.html — no depende de esta
# variable para eso, solo el resto de la app (Resend, páginas) sí.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel Cron (app/api/cron/email-reminders — correos #3/#4/#5) ---
# Generar un valor aleatorio largo (ej. `openssl rand -hex 32`) y
# configurarlo también como variable de entorno en el proyecto de Vercel:
# Vercel añade automáticamente el header `Authorization: Bearer $CRON_SECRET`
# a las invocaciones programadas cuando esta variable existe.
CRON_SECRET=

# --- Broadcast manual (app/api/admin/send-broadcast — correo #7) ---
# Secreto propio (no reutilizar CRON_SECRET) para quien del equipo
# dispare manualmente un envío de actualización de plataforma.
ADMIN_API_SECRET=
